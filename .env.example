# Copy to .env (gitignored — never commit real values) and fill in.
# docker-compose reads this automatically.

# ---------------------------------------------------------------------------
# OLTP (Postgres) — the "system of record" front-office database
# ---------------------------------------------------------------------------
OLTP_POSTGRES_DB=aether_trade
OLTP_POSTGRES_USER=aether_app
OLTP_POSTGRES_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Airflow metadata DB (Postgres) — separate instance from OLTP on purpose
# ---------------------------------------------------------------------------
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change_me

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Snowflake — used by dbt, inside the airflow-webserver/scheduler and dbt
# containers. This is a REAL Snowflake account's credentials; nothing here
# is a local/demo warehouse.
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AETHER_TRADE
SNOWFLAKE_SCHEMA=MART_DBT
